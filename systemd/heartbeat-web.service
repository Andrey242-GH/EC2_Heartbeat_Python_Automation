[Unit]
Description=EC2 Heartbeat Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heartbeat
Group=heartbeat

WorkingDirectory=/opt/EC2_Heartbeat_Python_Automation

Environment=OUTPUT_FILE=/var/lib/heartbeat/events.jsonl
Environment=PYTHONDONTWRITEBYTECODE=1

ExecStart=/opt/EC2_Heartbeat_Python_Automation/.venv/bin/gunicorn \
    --workers 2 \
    --bind 0.0.0.0:5000 \
    --access-logfile - \
    --error-logfile - \
    src.app:app

Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=heartbeat-web

[Install]
WantedBy=multi-user.target